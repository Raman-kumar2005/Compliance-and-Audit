# ==========================================
# AI Auditor — Environment Configuration Template
# ==========================================
# Copy this file to backend/.env and frontend/.env before running locally.
# DO NOT commit real API keys or passwords to version control.

# Google Gemini API Key (Required for AI Audit Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API Endpoint Configuration
VITE_API_URL=http://localhost:8000/api

# Optional SMTP Provider Configuration for Real Email Delivery
# (If unconfigured, notifications are recorded in auditable demo state)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@compliance-audit.org
